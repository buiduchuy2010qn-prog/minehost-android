    <string name="s565">Tải MT Manager</string>
    <string name="s566">MT Manager là trình quản lý tệp mạnh mẽ trên Android, hỗ trợ truy cập trực tiếp thư mục dữ liệu nội bộ của ứng dụng mà không cần Root.</string>
    <string name="s567">📥 Mở trang chủ tải MT Manager</string>
    <string name="s568">Hướng dẫn các bước</string>
    <string name="s569">Cài đặt MT Manager</string>
    <string name="s570">Tải và cài đặt MT Manager trên điện thoại.</string>
    <string name="s571">Mở thanh menu bên trái</string>
    <string name="s572">Mở MT Manager, vuốt từ cạnh trái sang phải hoặc nhấn biểu tượng menu (☰) ở góc trên bên trái.</string>
    <string name="s573">Thêm bộ nhớ cục bộ</string>
    <string name="s574">Chọn mục \"Quản lý bộ nhớ / Thêm bộ nhớ cục bộ\" trong thanh menu bên.</string>
    <string name="s575">Chọn ứng dụng MineHost</string>
    <string name="s576">Ở góc trên bên phải của trình chọn tệp hệ thống, mở menu và chọn \"MineHost\", sau đó nhấn Cho phép / Sử dụng thư mục này.</string>
    <string name="s577">Bắt đầu quản lý tệp</string>
    <string name="s578">Quay lại màn hình chính MT Manager, mục MineHost sẽ xuất hiện ở thanh bên để bạn duyệt và chỉnh sửa tệp trực tiếp.</string>
    <string name="s579">Vị trí thư mục server</string>
    <string name="s580">Truy cập đường dẫn files → home → servers để xem toàn bộ thư mục các máy chủ Minecraft (world, plugins, server.properties...).</string>
    <string name="s581">Lưu ý</string>
    <string name="s582">Sau khi sửa tệp cấu hình, hãy khởi động lại server để áp dụng. Tránh xóa thư mục world nếu chưa sao lưu.</string>
    <string name="s583">Cơ chế hoạt động</string>
    <string name="s584">MineHost tích hợp sẵn DocumentsProvider chuẩn của Android, cho phép MT Manager đọc/ghi trực tiếp dữ liệu server mà không cần quyền Root.</string>
    <string name="s406">Vì sao tải xuống bị chậm hoặc lỗi?</string>
    <string name="s407">Ứng dụng cần tải môi trường nền Termux (~50 MB), Java và core server từ GitHub/CDN quốc tế. Nếu mạng của bạn bị nghẽn tuyến quốc tế, hãy thử các cách dưới đây.</string>
    <string name="s408">Khuyên dùng</string>
    <string name="s409">Cách 1: Đổi nguồn tải môi trường (Bootstrap / GitHub)</string>
    <string name="s410">Ứng dụng hỗ trợ kết nối trực tiếp GitHub và nhiều cổng proxy dự phòng. Bạn có thể đổi nguồn tải trong phần Cài đặt.</string>
    <string name="s411">Mở mục \"Quản lý\" → \"Cài đặt\"</string>
    <string name="s412">Tìm mục \"Nguồn tải môi trường (Bootstrap)\"</string>
    <string name="s413">Chọn \"Tự động (khuyên dùng)\" hoặc \"GitHub trực tiếp\"</string>
    <string name="s414">Quay lại trang Tổng quan và nhấn Thử lại</string>
    <string name="s415">Ứng dụng sẽ tự động chuyển sang máy chủ tải ổn định nhất</string>
    <string name="s416">Cách 2: Đổi nguồn gói phần mềm (APT Mirror)</string>
    <string name="s417">Các gói OpenJDK, wget và thư viện phụ trợ được tải qua APT. Ở Việt Nam, nguồn Termux CDN (Quốc tế) cho tốc độ ổn định nhất.</string>
    <string name="s418">Tìm mục \"Nguồn gói phần mềm (APT Mirror)\" trong Cài đặt</string>
    <string name="s419">Chọn \"Termux CDN (Quốc tế)\" hoặc \"Termux Mirror (Hetzner)\"</string>
    <string name="s420">Quay lại cài đặt lại công cụ hoặc Java</string>
    <string name="s421">Nhanh</string>
    <string name="s422">Cách 3: Đổi kết nối mạng hoặc DNS</string>
    <string name="s423">Đôi khi nhà mạng chặn hoặc bóp băng thông kết nối quốc tế vào giờ cao điểm.</string>
    <string name="s424">Thử chuyển đổi giữa Wi-Fi và dữ liệu di động 4G/5G</string>
    <string name="s425">Thử bật DNS riêng (1.1.1.1 hoặc 8.8.8.8) trong cài đặt mạng của Android</string>
    <string name="s426">Với Java runtime, bạn có thể chọn nhóm \"Pojav JRE\" để tải trực tiếp không cần qua APT</string>
    <string name="s427">Với core server có sẵn, bạn có thể dùng nút \"Nhập server có sẵn\" trong Kho cài đặt</string>
</resources>
