    <string name="dl_desc_paper">PaperMC: Core hiệu năng cao tương thích hầu hết plugin Bukkit/Spigot (Khuyên dùng)</string>
    <string name="dl_desc_purpur">Purpur: Nhánh mở rộng của Paper với nhiều tùy chỉnh lối chơi và tối ưu tốt</string>
    <string name="dl_desc_leaves">Leaves: Nhánh Paper tối ưu cho server sinh tồn và máy farm/redstone</string>
    <string name="dl_desc_leaf">Leaf: Nhánh Paper tối ưu hiệu năng cao, tương thích plugin Bukkit/Paper</string>
    <string name="dl_desc_spigot">Spigot: Core plugin Bukkit truyền thống</string>
    <string name="dl_desc_craftbukkit">CraftBukkit: Bản dựng Bukkit gốc cho plugin đời cũ</string>
    <string name="dl_desc_fabric">Fabric: Mod loader gọn nhẹ, hỗ trợ nhanh nhất cho các phiên bản mới</string>
    <string name="dl_desc_forge">Forge: Mod loader lâu đời với hệ sinh thái modpack lớn</string>
    <string name="dl_desc_neoforge">NeoForge: Hệ sinh thái mod kế nhiệm Forge; tự chạy bộ cài sau khi tải</string>
    <string name="dl_desc_quilt">Quilt: Nhánh phát triển từ Fabric; tự chạy bộ cài sau khi tải</string>
    <string name="dl_desc_vanilla">Vanilla: Server Minecraft gốc chính thức từ Mojang</string>
    <string name="dl_desc_velocity">Velocity: Proxy hiệu năng cao kết nối nhiều server (không chạy world trực tiếp)</string>
    <string name="dl_desc_bungeecord">BungeeCord: Proxy truyền thống chuyển hướng giữa nhiều server</string>
    <string name="dl_desc_pnx">PowerNukkitX: Server Bedrock (cổng mặc định UDP 19132, khuyên dùng Java 25)</string>
    <string name="dl_desc_pocketmine">PocketMine-MP: Server Bedrock chạy trên PHP, cổng mặc định UDP 19132</string>
    <string name="dl_desc_allay">Allay: Server Bedrock hiệu năng cao dùng Java 21+, cổng mặc định UDP 19132</string>
    <string name="dl_desc_unknown">Core chưa rõ loại (thường sau khi khôi phục backup); có thể chọn lại</string>
